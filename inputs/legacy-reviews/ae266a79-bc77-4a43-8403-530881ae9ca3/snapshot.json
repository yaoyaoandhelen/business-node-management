      "node.submit": {
        "reqId": "node.submit",
        "featureName": "提交与两阶段审核",
        "interactionSteps": [
          "在页面设计空间体验交互",
          "在功能需求空间点击对应元素查看说明"
        ],
        "businessRules": [
          "先校验必填、版本号与HTTPS地址，然后启动机器审核",
          "审核中不可重复提交；通过才创建待人工审核记录",
          "命中风险展示字段和风险类别并保留表单；异常不得绕过机器审核进入人工审核",
          "原型通过演示场景和测试词模拟结果，未接入真实模型；投产需后端模型审核、文件解析/OCR及幂等提交，禁止只依赖前端判断"
        ],
        "fieldValidations": [],
        "permissions": [],
